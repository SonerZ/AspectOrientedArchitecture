@{
    ViewData["Title"] = "Anasayfa";
}

@using Application.Entities.CustomEntities.User
@using Application.MVCUI.Services.Session
@inject ISessionService SessionService

@{
    var user = SessionService?.Get<UserDto>("user-session");
}

<div class="container-fluid">

                <!-- start page title -->
                <div class="row">
                    <div class="col-12">
                
                        <div class="card text-center col-md-4 mt-3">
                            <div class="card-body">
                                <img src="assets/images/users/avatar-1.jpg" class="rounded-circle avatar-lg img-thumbnail" alt="profile-image">

                                <h4 class="mb-0 mt-2">@user.Username</h4>
                                <p class="text-muted font-14">@user.LastLoginDate</p>

                        

                                <div class="text-left mt-3">
                                    <h4 class="font-13 text-uppercase">Oturum Bileti :</h4>
                                    <p class="text-muted font-13 mb-3">
                                        @user.TokenInformation.Token
                                    </p>

                                    <p class="text-muted mb-2 font-13"><strong>Oturum Bitişi :</strong><span class="ml-2">@user.TokenInformation.ExpiryDate</span></p>

                                    <p class="text-muted mb-2 font-13"><strong>Tam Adı :</strong> <span class="ml-2">@user.Username</span></p>

                                    <p class="text-muted mb-2 font-13"><strong>Son Oturum :</strong><span class="ml-2">@user.LastLoginDate</span></p>

                                    <p class="text-muted mb-2 font-13"><strong>Kullanıcı Adı :</strong> <span class="ml-2 ">@user.Username</span></p>
                                    
                                </div>

                     
                            </div> <!-- end card-body -->
                        </div>
                    </div>
                </div>
                <!-- end page title -->
           

            </div>
            <!-- container -->