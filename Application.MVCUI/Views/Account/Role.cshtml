
@{
    ViewData["Title"] = "Fonksiyon Yönetimi";
}

@using Application.Entities.CustomEntities.User
@using Application.MVCUI.Services.Session
@inject ISessionService SessionService

@{
    var user = SessionService?.Get<UserDto>("user-session");
    List<RoleDto> roles = (List<RoleDto>)TempData["Roles"];
    List<ClaimDto> claims = (List<ClaimDto>)TempData["Claims"];
}

<div class="container-fluid mt-4">
    <div class="card col-md-8 m-2 p-2">
        <div class="card-header">
            <h5>Rol İşlemleri <button data-toggle="modal" data-target="#dark-header-modal-second" class="btn btn-sm btn-secondary" onclick="setUserRole('@user.Id')">
                    <i class=" dripicons-backspace"></i> Claim Ata
                </button></h5>
        </div>
        <div class="mt-1" id="grid"></div>
    </div>
</div>


<div id="dark-header-modal-second" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="dark-header-modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modal-colored-header bg-secondary">
                <h4 class="modal-title" id="dark-header-modalLabel">Claim Ata</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="modal-body">
                <select id="role" class="form-control select2" data-toggle="select2">
                    <option>Rol Seçin</option>
                    <optgroup label="Roller">
                        @foreach (var role in roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </optgroup>

                </select>
                <br/> <br/> 
                <select id="claim" class="form-control select2" data-toggle="select2">
                    <option>Claim Seçin</option>
                    <optgroup label="Roller">
                        @foreach (var claim in claims)
                        {
                            <option value="@claim.Id">@claim.Type / @claim.Value</option>
                        }
                    </optgroup>

                </select>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">Kapat</button>
                <button type="button" onclick="setClaim()" class="btn btn-dark">Kaydet</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    
    function setClaim()
    {
        var claim = document.getElementById('claim').value;
        var role = document.getElementById('role').value;

        fetch(`/Account/AddClaimToRole/`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                ClaimId: claim,
                RoleId: role,
            })
        })
            .then(response => response.json())
            .then(data => {
                if (data.isSuccess) {
                    window.location = ""
                } else {
                    alert(data.messages[0].value);
                }
            })
    }
    
    $(() => {
        const URL = 'http://localhost:1400';

        const functionStore = new DevExpress.data.CustomStore({
            key: 'id',
            load() {

                return sendRequest(`${URL}/role`).then(data => {

                    if (!data || !Array.isArray(data)) {
                        console.log(data)
                        console.error("Geçersiz veri alındı.");
                        return [];
                    }


                    return data;
                });
            },
            insert(values) {
                return sendRequest(`${URL}/role`, 'POST', values);
            },
            update(key, values) {
                console.log(values)
                return sendRequest(`${URL}/role`, 'PUT', {
                    id: key,
                    name: values.title,
                    title: values.title
                });
            },
            remove(key) {
                return sendRequest(`${URL}/role?key=${key}`, 'DELETE');
            }
        });


        const dataGrid = $('#grid').dxDataGrid({
            dataSource: functionStore,
            repaintChangesOnly: true,
            showBfunction: true,
            editing: {
                refreshMode: 'reshape',
                mode: 'cell',
                allowAdding: true,
                allowUpdating: true,
                allowDeleting: true
            },
            scrolling: {
                mode: 'virtual',
            },
            columns: [
                {
                    dataField: 'id',
                    caption: 'id',
                    dataType: 'text',
                },
                {
                    dataField: 'name',
                    caption: 'Name',
                    dataType: 'text',
                },
                {
                    dataField: 'title',
                    caption: 'Title',
                    dataType: 'text',
                }
            ],
            summary: {
                totalItems: [
                    {
                        column: 'id',
                        summaryType: 'count',
                    }
                ]
            }
        }).dxDataGrid('instance');

        $('#refresh-mode').dxSelectBox({
            items: ['full', 'reshape', 'repaint'],
            value: 'reshape',
            inputAttr: { 'aria-label': 'Refresh Mode' },
            onValueChanged(e) {
                dataGrid.option('editing.refreshMode', e.value);
            }
        });

        $('#clear').dxButton({
            text: 'Clear',
            onClick() {
                $('#requests ul').empty();
            },
        });

        function sendRequest(url, method = 'GET', data = {}) {
            const d = $.Deferred();

            logRequest(method, url, data);

            $.ajax({
                url: url,
                method: method,
                data: data,
                cache: false,
                xhrFields: { withCredentials: true },
                headers: {
                    'Authorization': 'Bearer @user.TokenInformation.Token' 
                },
                success: function (result) {
                    d.resolve(method === 'GET' ? result.data : result);
                },
                error: function (xhr) {
                    d.reject(xhr.responseJSON ? xhr.responseJSON.Message : xhr.statusText);
                }
            });


            return d.promise();
        }

        function logRequest(method, url, data) {
            const args = Object.keys(data || {}).map((key) => `${key}=${data[key]}`).join(' ');

            const logList = $('#requests ul');
            const time = DevExpress.localization.formatDate(new Date(), 'HH:mm:ss');
            const newItem = $('<li>').text([time, method, url.slice(URL.length), args].join(' '));

            logList.prepend(newItem);
        }
    });


</script>


